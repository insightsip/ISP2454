if BOARD_ISP2454_LX_TB_NRF54L15_CPUAPP_NS || \
   BOARD_ISP2454_LX_TB_MX_NRF54L15_CPUAPP_NS || \
   BOARD_ISP2454_LX_TB_RN_NRF54L15_CPUAPP_NS || \
   BOARD_ISP2454_LP_TB_MX_NRF54L15_CPUAPP_NS || \
   BOARD_ISP2454_LP_TB_RN_NRF54L15_CPUAPP_NS

config HAS_BT_CTLR
	default BT

# Non-Secure builds use TF-M as the Secure Execution Environment by default.
config BUILD_WITH_TFM
	default y

endif # *_NS
